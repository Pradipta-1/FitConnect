# ==========================================
# FitConnect Environment Configuration
# ==========================================

# Database Connection
# Option A (Local Embedded PostgreSQL - Default):
# DATABASE_URL="postgresql://postgres:password123@127.0.0.1:5433/fitconnect"
#
# Option B (Supabase PostgreSQL):
# Format: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# (Or direct port 5432 session pooler: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres)
DATABASE_URL="postgresql://postgres:password123@127.0.0.1:5433/fitconnect"

# JWT Secret for Session Authentication
JWT_SECRET="fitconnect-production-secret-key-360codecraft-2026"

# Supabase API & Storage Configuration
# Project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# Supabase Service Role Key (Server-side only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY="YOUR-SUPABASE-SERVICE-ROLE-KEY"

# Supabase Anon Key (Public / Client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-SUPABASE-ANON-KEY"
